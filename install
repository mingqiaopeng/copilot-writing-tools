# 中文文稿写作 Agent 工具集 一键安装脚本
# 用法:
#   irm https://raw.githubusercontent.com/mingqiaopeng/copilot-writing-tools/master/install | iex
# 本地执行:
#   先改名为 install.ps1，再 .\install.ps1
# 说明：统一安装脚本，同时部署 Copilot 端（~/.copilot/）和 Continue 端（~/.continue/）

$RepoBranch = "master"
$BaseUrl    = "https://raw.githubusercontent.com/mingqiaopeng/copilot-writing-tools/$RepoBranch"
$CopilotDir = "$env:USERPROFILE\.copilot"
$ContinueDir = "$env:USERPROFILE\.continue"

$Agents = @(
    "点子王.agent.md",
    "批判家.agent.md",
    "分析师.agent.md",
    "档案员.agent.md"
)

$Skills = @(
    "写中心句",
    "摘要生成",
    "标题优化",
    "段落重组",
    "大纲生成",
    "增加过渡",
    "缩减篇幅",
    "扩充篇幅",
    "合并段落",
    "拆分段落",
    "简化修辞",
    "神来之笔",
    "增加修辞",
    "去除标签",
    "校对勘误",
    "统一风格",
    "传达提纲",
    "优化句式",
    "量化分析"
)

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "  中文文稿写作 Agent 工具集 一键安装" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Copilot 部署目标: $CopilotDir" -ForegroundColor Gray
Write-Host "Continue 部署目标: $ContinueDir" -ForegroundColor Gray
Write-Host "数据来源: $BaseUrl" -ForegroundColor Gray
Write-Host ""

# ── 创建目录 ──
Write-Host "[目录]" -ForegroundColor Yellow
$dirs = @(
    "$CopilotDir\agents",
    "$CopilotDir\skills",
    "$ContinueDir\prompts",
    "$ContinueDir\rules"
)
foreach ($dir in $dirs) {
    Write-Host "  创建 $dir"
    $null = New-Item -ItemType Directory -Force -Path $dir
}

# ── 下载 Agents（Copilot 端）──
Write-Host ""
Write-Host "[Copilot] Agents ($($Agents.Count) 个)" -ForegroundColor Yellow
foreach ($name in $Agents) {
    $url  = "$BaseUrl/.copilot/agents/$name"
    $dest = "$CopilotDir\agents\$name"
    Write-Host "  $url" -ForegroundColor Gray
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 下载工具脚本 ──
Write-Host ""
Write-Host "[Tools] 量化分析引擎" -ForegroundColor Yellow
$toolsDir = "$CopilotDir\tools\scripts"
$null = New-Item -ItemType Directory -Force -Path $toolsDir
$toolUrl = "$BaseUrl/tools/scripts/analyze.py"
$toolDest = "$toolsDir\analyze.py"
Write-Host "  $toolUrl" -ForegroundColor Gray
try {
    Invoke-WebRequest -Uri $toolUrl -OutFile $toolDest -ErrorAction Stop | Out-Null
    Write-Host "  [OK] tools/scripts/analyze.py" -ForegroundColor Green
} catch {
    Write-Host "  [FAIL] analyze.py — $($_.Exception.Message)" -ForegroundColor Red
}

# ── 下载 Skills（Copilot 端）──
Write-Host ""
Write-Host "[Copilot] Skills ($($Skills.Count) 个)" -ForegroundColor Yellow
foreach ($name in $Skills) {
    $url  = "$BaseUrl/.copilot/skills/$name/SKILL.md"
    $dest = "$CopilotDir\skills\$name\SKILL.md"
    Write-Host "  $url" -ForegroundColor Gray
    $null = New-Item -ItemType Directory -Force -Path "$CopilotDir\skills\$name"
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name/SKILL.md" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 风格模板（统一风格 Skill 需要）──
Write-Host ""
Write-Host "[Copilot] 风格模板" -ForegroundColor Yellow
$styleDir = "$CopilotDir\skills\统一风格"
$null = New-Item -ItemType Directory -Force -Path $styleDir
$styleFiles = @("China_Daily_Style.json", "QiuShi_Style.json", "SGCC_Daily_Style.json", "Study_Time_Style.json")
foreach ($name in $styleFiles) {
    $url  = "$BaseUrl/.copilot/skills/统一风格/$name"
    $dest = "$styleDir\$name"
    Write-Host "  $url" -ForegroundColor Gray
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 下载 MCP 服务器 ──
Write-Host ""
Write-Host "[MCP 服务器] local-search-mcp-server" -ForegroundColor Yellow
$mcpDir = "$CopilotDir\local-search-mcp-server"
$null = New-Item -ItemType Directory -Force -Path $mcpDir
$mcpFiles = @("index.js", "package.json", "config.example.json")
foreach ($name in $mcpFiles) {
    $url  = "$BaseUrl/local-search-mcp-server/$name"
    $dest = "$mcpDir\$name"
    Write-Host "  $url" -ForegroundColor Gray
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 备份函数 ──
function Backup-File {
    param([string]$Path)
    if (Test-Path $Path) {
        $stamp = Get-Date -Format "yyyyMMdd_HHmmss"
        $backup = "${Path}.bak.${stamp}"
        Copy-Item $Path $backup -Force
        Write-Host "  [BACKUP] 已备份至 $backup" -ForegroundColor Gray
    }
}

# ── 生成 MCP config.json（不存在时从 example 复制）──
Write-Host ""
Write-Host "  检查 MCP 配置..."
$mcpConfigDest = "$mcpDir\config.json"
if (Test-Path $mcpConfigDest) {
    Write-Host "  [OK] config.json 已存在，保持原样" -ForegroundColor Gray
} else {
    Copy-Item "$mcpDir\config.example.json" $mcpConfigDest -Force
    Write-Host "  [OK] config.json 已从模板生成" -ForegroundColor Green
    Write-Host "  ⚠ 请编辑 $mcpConfigDest 填写本地路径（kbRoot、rhetoricDbPath）" -ForegroundColor Yellow
}

# ── npm install ──
Write-Host ""
Write-Host "  正在安装 MCP 服务器依赖 (npm install)..." -ForegroundColor Gray
Push-Location $mcpDir
npm install --production
if ($LASTEXITCODE -ne 0) {
    Write-Host "  [WARN] npm install 失败，请手动在 $mcpDir 中执行 npm install" -ForegroundColor Yellow
} else {
    Write-Host "  [OK] 依赖安装完成" -ForegroundColor Green
}
Pop-Location

# ── MCP 配置 — 合并到 VS Code 的 mcp.json（Copilot 端需要）──
Write-Host ""
Write-Host "  正在配置 MCP 服务器到 VS Code..." -ForegroundColor Gray
$vsCodeMcpPath = "$env:APPDATA\Code\User\mcp.json"

$null = New-Item -ItemType Directory -Force -Path (Split-Path $vsCodeMcpPath -Parent)

$existingConfig = $null
if (Test-Path $vsCodeMcpPath) {
    try {
        $existingConfig = Get-Content -Raw -Path $vsCodeMcpPath | ConvertFrom-Json
        Write-Host "  检测到已有 MCP 配置，将自动合并。" -ForegroundColor Gray
    } catch {
        Write-Host "  [WARN] 现有 mcp.json 格式异常，将备份后覆盖。" -ForegroundColor Yellow
        Backup-File -Path $vsCodeMcpPath
        $existingConfig = $null
    }
}

$indexPath = "$mcpDir\index.js"
if ($existingConfig -and $existingConfig.servers) {
    $existingConfig.servers | Add-Member -MemberType NoteProperty -Name "local-search-mcp-server" -Value @{
        command = "node"
        type    = "stdio"
        args    = @($indexPath)
    } -Force
    $mergedConfig = $existingConfig
} else {
    $mergedConfig = @{
        servers = @{
            "local-search-mcp-server" = @{
                command = "node"
                type    = "stdio"
                args    = @($indexPath)
            }
        }
    }
}

try {
    Backup-File -Path $vsCodeMcpPath
    $mergedConfig | ConvertTo-Json -Depth 4 | Out-File -FilePath $vsCodeMcpPath -Encoding UTF8 -Force
    Write-Host "  [OK] MCP 配置已写入 $vsCodeMcpPath" -ForegroundColor Green
} catch {
    Write-Host "  [FAIL] 无法写入 MCP 配置文件 — $($_.Exception.Message)" -ForegroundColor Red
    Write-Host "  请手动将以下内容添加到 $vsCodeMcpPath ：" -ForegroundColor Yellow
    $mcpSnippet = @{
        servers = @{
            "local-search-mcp-server" = @{
                command = "node"
                type    = "stdio"
                args    = @($indexPath)
            }
        }
    }
    Write-Host ($mcpSnippet | ConvertTo-Json -Depth 3) -ForegroundColor Gray
}

# ── 下载 .continue/ 适配层（Continue 端）──
Write-Host ""
Write-Host "[Continue] 适配层 (.continue/)" -ForegroundColor Yellow

# 备份用户已有的 config.yaml 后再覆盖
$continueCfg = "$ContinueDir\config.yaml"
Backup-File -Path $continueCfg

$continueFiles = @(
    @{src = "config.yaml"; dest = "config.yaml"},
    @{src = "prompts/写中心句.prompt"; dest = "prompts\写中心句.prompt"},
    @{src = "prompts/标题优化.prompt"; dest = "prompts\标题优化.prompt"},
    @{src = "prompts/量化分析.prompt"; dest = "prompts\量化分析.prompt"}
    # 注：更多 .prompt 和 .mdc 文件将由仓库维护者逐步添加
)
foreach ($file in $continueFiles) {
    $url  = "$BaseUrl/.continue/$($file.src)"
    $dest = "$ContinueDir\$($file.dest)"
    $null = New-Item -ItemType Directory -Force -Path (Split-Path $dest -Parent)
    Write-Host "  $url" -ForegroundColor Gray
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $($file.src)" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $($file.src) — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── Python 依赖（量化分析 Skill 需要 jieba）──
Write-Host ""
Write-Host "[Python 依赖] jieba — 量化分析 Skill 分词引擎" -ForegroundColor Yellow
Write-Host "  正在安装 jieba (pip install jieba)..." -ForegroundColor Gray
$pipResult = pip install jieba 2>&1
if ($LASTEXITCODE -ne 0) {
    Write-Host "  [WARN] pip install jieba 失败，请手动安装: pip install jieba" -ForegroundColor Yellow
} else {
    Write-Host "  [OK] jieba 安装完成" -ForegroundColor Green
}

# ── 收尾 ──
Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "  安装完成" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "Copilot 端已部署到: $CopilotDir"
Write-Host "  agents/                          ($($Agents.Count) 个 Agent)"
Write-Host "  skills/                          ($($Skills.Count) 个 Skill)"
Write-Host "  local-search-mcp-server/         MCP 服务器（档案员 + 神来之笔）"
Write-Host "  MCP 配置已合并至 %APPDATA%\Code\User\mcp.json"
Write-Host ""
Write-Host "Continue 端已部署到: $ContinueDir"
Write-Host "  config.yaml                      配置"
Write-Host "  prompts/                         斜杠命令"
Write-Host "  rules/                           角色规则"
Write-Host ""
Write-Host "⚠ 首次安装后请务必编辑 MCP 配置：" -ForegroundColor Yellow
Write-Host "  编辑 $mcpConfigDest" -ForegroundColor Yellow
Write-Host "  填写 kbRoot（知识库根路径）和 rhetoricDbPath（好词好句.jsonl 路径）" -ForegroundColor Yellow
Write-Host ""
Write-Host "重启 VS Code 或 Continue 后生效。" -ForegroundColor Gray
Write-Host ""
