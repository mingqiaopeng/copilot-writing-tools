# 中文文稿写作 Agent 工具集 一键安装脚本
# 用法:
#   irm https://raw.githubusercontent.com/mingqiaopeng/copilot-writing-tools/master/install | iex
# 本地执行:
#   先改名为 install.ps1，再 .\install.ps1

$RepoBranch = "master"
$BaseUrl    = "https://raw.githubusercontent.com/mingqiaopeng/copilot-writing-tools/$RepoBranch"
$TargetDir  = "$env:USERPROFILE\.copilot"

$Agents = @(
    "点子王.agent.md",
    "批判家.agent.md",
    "分析师.agent.md"
)

$Skills = @(
    "写中心句",
    "摘要生成",
    "标题优化",
    "段落重组",
    "大纲生成",
    "增加过渡",
    "缩减篇幅",
    "扩充篇幅",
    "合并段落",
    "拆分段落",
    "简化修辞",
    "增加修辞",
    "去除标签",
    "校对勘误"
)

Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "  中文文稿写作 Agent 工具集 一键安装" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "安装目标: $TargetDir" -ForegroundColor Gray
Write-Host "数据来源: $BaseUrl" -ForegroundColor Gray
Write-Host ""

# ── 创建目录 ──
Write-Host "[目录]" -ForegroundColor Yellow
$dirs = @(
    "$TargetDir\agents",
    "$TargetDir\skills"
)
foreach ($dir in $dirs) {
    Write-Host "  创建 $dir"
    $null = New-Item -ItemType Directory -Force -Path $dir
}

# ── 下载 Agents ──
Write-Host ""
Write-Host "[Agents] ($($Agents.Count) 个)" -ForegroundColor Yellow
foreach ($name in $Agents) {
    $url  = "$BaseUrl/agents/$name"
    $dest = "$TargetDir\agents\$name"
    Write-Host "  $url" -ForegroundColor Gray
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 下载 Skills ──
Write-Host ""
Write-Host "[Skills] ($($Skills.Count) 个)" -ForegroundColor Yellow
foreach ($name in $Skills) {
    $url  = "$BaseUrl/skills/$name/SKILL.md"
    $dest = "$TargetDir\skills\$name\SKILL.md"
    Write-Host "  $url" -ForegroundColor Gray
    $null = New-Item -ItemType Directory -Force -Path "$TargetDir\skills\$name"
    try {
        Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
        Write-Host "  [OK] $name/SKILL.md" -ForegroundColor Green
    } catch {
        Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
    }
}

# ── 下载 README ──
Write-Host ""
Write-Host "[README]" -ForegroundColor Yellow
$readmeUrl  = "$BaseUrl/README.md"
$readmeDest = "$TargetDir\copilot-writing-tools-README.md"
Write-Host "  $readmeUrl" -ForegroundColor Gray
try {
    Invoke-WebRequest -Uri $readmeUrl -OutFile $readmeDest -ErrorAction Stop | Out-Null
    Write-Host "  [OK] copilot-writing-tools-README.md" -ForegroundColor Green
} catch {
    Write-Host "  [FAIL] README.md — $($_.Exception.Message)" -ForegroundColor Red
}

# ── 档案员（可选） ──
Write-Host ""
Write-Host "============================================" -ForegroundColor DarkYellow
Write-Host "  [可选] 档案员 Agent — 本地知识库检索" -ForegroundColor DarkYellow
Write-Host "============================================" -ForegroundColor DarkYellow
Write-Host ""
Write-Host "档案员需要额外配置 Everything (es.exe)、ripgrep (rg) 和 MCP 服务器" -ForegroundColor Gray
Write-Host "仅推荐高级用户安装。详见 README 中档案员配置说明。" -ForegroundColor Gray
Write-Host ""

$installArchivist = Read-Host "是否安装档案员？(y/n，默认 n)"
if ($installArchivist -ne 'y' -and $installArchivist -ne 'Y') {
    Write-Host "  已跳过档案员安装。" -ForegroundColor Gray
} else {
    # 下载档案员 Agent 文件
    Write-Host ""
    Write-Host "[档案员 Agent]" -ForegroundColor Yellow
    $archivistFiles = @("档案员.agent.md")
    foreach ($name in $archivistFiles) {
        $url  = "$BaseUrl/agents/$name"
        $dest = "$TargetDir\agents\$name"
        Write-Host "  $url" -ForegroundColor Gray
        try {
            Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
            Write-Host "  [OK] $name" -ForegroundColor Green
        } catch {
            Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
        }
    }

    # 档案员配置 — 智能合并，不覆盖用户已有值
    $configName = "档案员.config.json"
    $configUrl  = "$BaseUrl/agents/$configName"
    $configDest = "$TargetDir\agents\$configName"
    Write-Host "  $configUrl" -ForegroundColor Gray
    try {
        $templateJson = Invoke-RestMethod -Uri $configUrl
        if (Test-Path $configDest) {
            # 已有配置 → 只补充新增 key，保留用户现有值
            $localConfig = Get-Content -Raw -Path $configDest | ConvertFrom-Json
            $merged = $localConfig
            $added = @()
            foreach ($prop in $templateJson.PSObject.Properties) {
                if (-not ($localConfig.PSObject.Properties.Name -contains $prop.Name)) {
                    $merged | Add-Member -MemberType NoteProperty -Name $prop.Name -Value $prop.Value
                    $added += $prop.Name
                }
            }
            if ($added.Count -gt 0) {
                Copy-Item $configDest "$configDest.bak" -Force
                $merged | ConvertTo-Json -Depth 4 | Out-File -FilePath $configDest -Encoding UTF8 -Force
                Write-Host "  [OK] $configName — 补充新字段: $($added -join ', ')，已有配置已备份" -ForegroundColor Green
            } else {
                Write-Host "  [OK] $configName — 配置已存在，无新增字段，保持原样" -ForegroundColor Gray
            }
        } else {
            # 首次安装 → 直接写入模板
            $templateJson | ConvertTo-Json -Depth 4 | Out-File -FilePath $configDest -Encoding UTF8 -Force
            Write-Host "  [OK] $configName — 首次安装，写入模板（请修改 kbRoot 为实际路径）" -ForegroundColor Green
        }
    } catch {
        Write-Host "  [FAIL] $configName — $($_.Exception.Message)" -ForegroundColor Red
    }

    # 下载 MCP 服务器文件
    Write-Host ""
    Write-Host "[MCP 服务器] local-search-mcp-server" -ForegroundColor Yellow
    $mcpDir = "$TargetDir\local-search-mcp-server"
    $null = New-Item -ItemType Directory -Force -Path $mcpDir
    $mcpFiles = @("index.js", "package.json")
    foreach ($name in $mcpFiles) {
        $url  = "$BaseUrl/local-search-mcp-server/$name"
        $dest = "$mcpDir\$name"
        Write-Host "  $url" -ForegroundColor Gray
        try {
            Invoke-WebRequest -Uri $url -OutFile $dest -ErrorAction Stop | Out-Null
            Write-Host "  [OK] $name" -ForegroundColor Green
        } catch {
            Write-Host "  [FAIL] $name — $($_.Exception.Message)" -ForegroundColor Red
        }
    }

    # npm install
    Write-Host ""
    Write-Host "  正在安装 MCP 服务器依赖 (npm install)..." -ForegroundColor Gray
    Push-Location $mcpDir
    npm install --production
    if ($LASTEXITCODE -ne 0) {
        Write-Host "  [WARN] npm install 失败，请手动在 $mcpDir 中执行 npm install" -ForegroundColor Yellow
    } else {
        Write-Host "  [OK] 依赖安装完成" -ForegroundColor Green
    }
    Pop-Location

    # MCP 配置文件 — 智能合并到 VS Code 的 mcp.json
    Write-Host ""
    Write-Host "  正在配置 MCP 服务器..." -ForegroundColor Gray
    $vsCodeMcpPath = "$env:APPDATA\Code\User\mcp.json"
    $indexPath = "$mcpDir\index.js"

    # 确保目录存在
    $null = New-Item -ItemType Directory -Force -Path (Split-Path $vsCodeMcpPath -Parent)

    # 读取已有配置（如存在）
    $existingConfig = $null
    if (Test-Path $vsCodeMcpPath) {
        try {
            $existingConfig = Get-Content -Raw -Path $vsCodeMcpPath | ConvertFrom-Json
            Write-Host "  检测到已有 MCP 配置，将自动合并。" -ForegroundColor Gray
        } catch {
            Write-Host "  [WARN] 现有 mcp.json 格式异常，将备份后覆盖。" -ForegroundColor Yellow
            Copy-Item $vsCodeMcpPath "$vsCodeMcpPath.bak" -Force
            $existingConfig = $null
        }
    }

    # 构建或合并 servers 节点
    if ($existingConfig -and $existingConfig.servers) {
        $existingConfig.servers | Add-Member -MemberType NoteProperty -Name "local-search-mcp-server" -Value @{
            command = "node"
            type    = "stdio"
            args    = @($indexPath)
        } -Force
        $mergedConfig = $existingConfig
    } else {
        $mergedConfig = @{
            servers = @{
                "local-search-mcp-server" = @{
                    command = "node"
                    type    = "stdio"
                    args    = @($indexPath)
                }
            }
        }
    }

    try {
        # 备份原文件
        if (Test-Path $vsCodeMcpPath) {
            Copy-Item $vsCodeMcpPath "$vsCodeMcpPath.bak" -Force
        }
        $mergedConfig | ConvertTo-Json -Depth 4 | Out-File -FilePath $vsCodeMcpPath -Encoding UTF8 -Force
        Write-Host "  [OK] MCP 配置已写入 $vsCodeMcpPath" -ForegroundColor Green
        if (Test-Path "$vsCodeMcpPath.bak") {
            Write-Host "  原配置已备份至 $vsCodeMcpPath.bak" -ForegroundColor Gray
        }
    } catch {
        Write-Host "  [FAIL] 无法写入 MCP 配置文件 — $($_.Exception.Message)" -ForegroundColor Red
        Write-Host "  请手动将以下内容添加到 $vsCodeMcpPath ：" -ForegroundColor Yellow
        $mcpSnippet = @{
            servers = @{
                "local-search-mcp-server" = @{
                    command = "node"
                    type    = "stdio"
                    args    = @($indexPath)
                }
            }
        }
        Write-Host ($mcpSnippet | ConvertTo-Json -Depth 3) -ForegroundColor Gray
    }
}

# ── 收尾 ──
$agentCount = if ($installArchivist -eq 'y' -or $installArchivist -eq 'Y') { 4 } else { 3 }
Write-Host ""
Write-Host "============================================" -ForegroundColor Cyan
Write-Host "  安装完成" -ForegroundColor Cyan
Write-Host "============================================" -ForegroundColor Cyan
Write-Host ""
Write-Host "已部署到: $TargetDir"
Write-Host "  copilot-writing-tools-README.md  说明文档"
Write-Host "  agents/                          ($agentCount 个 Agent)"
Write-Host "  skills/                          ($($Skills.Count) 个 Skill)"
if ($installArchivist -eq 'y' -or $installArchivist -eq 'Y') {
    Write-Host "  local-search-mcp-server/         MCP 服务器"
    Write-Host "  MCP 配置已合并至 %APPDATA%\Code\User\mcp.json"
}
Write-Host ""
Write-Host "重启 VS Code 后生效。执行 Developer: Reload Window 亦可。" -ForegroundColor Gray
Write-Host ""
